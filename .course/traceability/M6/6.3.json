  "source_corrections": [
    {
      "issue": "El reto titula PUT /api/v1/perfil/password pero el snippet usa AuthController /api/v1/auth/password.",
      "resolution": "La implementación usa /api/v1/perfil/password autenticado para evitar que el wildcard público de auth lo abra accidentalmente."
    },
    {
      "issue": "La fuente usa NegocioException para password actual incorrecta.",
      "resolution": "M5 marca NegocioException @Deprecated; se usa OperacionNoPermitidaException."
    },
    {
      "issue": "El inicializador fuente corta con usuarioRepository.count() > 0.",
      "resolution": "Se usa find-or-create idempotente por entidad para preservar evolución acumulativa."
    }
  ],
