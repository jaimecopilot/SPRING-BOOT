{
  "info": {
    "name": "M3 - mi-proyecto",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET alumnos",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/alumnos?page=0&size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "alumnos"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('content existe', () => pm.expect(pm.response.json()).to.have.property('content'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "POST alumno",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\":\"María\",\"apellidos\":\"López\",\"dni\":\"11111111C\",\"fechaNacimiento\":\"2011-03-20\",\"curso\":\"4º\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/alumnos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "alumnos"
          ]
        }
      }
    }
  ]
}